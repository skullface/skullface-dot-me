---
// Fetch the latest Spotify activity
import fetch from 'node-fetch';
import Tooltip from './Tooltip.astro';

interface SpotifyTrack {
  name: string;
  artists: Array<{ name: string }>;
  album: {
    name: string;
    images: Array<{ url: string }>;
  };
  external_urls: {
    spotify: string;
  };
}

interface SpotifyTokenResponse {
  access_token: string;
  token_type: string;
  expires_in: number;
}

interface SpotifyRecentlyPlayed {
  items: Array<{
    track: SpotifyTrack;
    played_at: string;
  }>;
}

let latestSong: SpotifyTrack | null = null;
let error: string | null = null;

// You'll need to set these environment variables
const clientId = import.meta.env.SPOTIFY_CLIENT_ID;
const clientSecret = import.meta.env.SPOTIFY_CLIENT_SECRET;
const refreshToken = import.meta.env.SPOTIFY_REFRESH_TOKEN;

try {
  if (!clientId || !clientSecret || !refreshToken) {
    error = "Spotify credentials not configured";
  } else {
    // Get access token using refresh token
    const tokenResponse = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Authorization': `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString('base64')}`
      },
      body: new URLSearchParams({
        grant_type: 'refresh_token',
        refresh_token: refreshToken
      })
    });

    if (!tokenResponse.ok) {
      throw new Error('Failed to get access token');
    }

    const tokenData = await tokenResponse.json() as SpotifyTokenResponse;
    const accessToken = tokenData.access_token;

    // Fetch recently played tracks
    const recentlyPlayedResponse = await fetch('https://api.spotify.com/v1/me/player/recently-played?limit=1', {
      headers: {
        'Authorization': `Bearer ${accessToken}`
      }
    });

    if (!recentlyPlayedResponse.ok) {
      throw new Error('Failed to fetch recently played tracks');
    }

    const recentlyPlayedData = await recentlyPlayedResponse.json() as SpotifyRecentlyPlayed;
    
    if (recentlyPlayedData.items && recentlyPlayedData.items.length > 0) {
      latestSong = recentlyPlayedData.items[0].track;
    }
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Unknown error occurred';
  console.error('Spotify API error:', err);
  
  // Add more detailed error logging
  if (err instanceof Error) {
    console.error('Error details:', {
      message: err.message,
      stack: err.stack,
      clientId: clientId ? 'set' : 'missing',
      clientSecret: clientSecret ? 'set' : 'missing', 
      refreshToken: refreshToken ? 'set' : 'missing'
    });
  }
}
---

{latestSong && !error ? (
  <>
    {latestSong.album.images && latestSong.album.images.length > 0 && (
      <Tooltip 
        content={`${latestSong.name} by ${latestSong.artists.map(artist => artist.name).join(', ')}`}
        ariaLabel={`${latestSong.name} by ${latestSong.artists.map(artist => artist.name).join(', ')}`}
        class="album-poster-container draggable"
      >
        <img class="album-poster" src={latestSong.album.images[0].url} alt="" />
        <div slot="tooltip-content">
          <div class="song-title">{latestSong.name}</div>
          <div class="artist-name">{latestSong.artists.map(artist => artist.name).join(', ')}</div>
        </div>
      </Tooltip>
    )}
  </>
) : error ? (
  <></>
) : null}

<style>
  .album-poster-container {
    display: block;
  }
  img.album-poster {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 120px;
    border: 1px solid color-mix(
      in lab,
      var(--color-foreground),
      var(--color-background) 80%
    );
    object-fit: cover;
    box-shadow: 0 2px 0 rgb(0, 0, 0, 0.2);
  }

  .song-title {
    font-weight: 600;
    color: var(--color-foreground);
    margin-bottom: 2px;
  }

  .artist-name {
    color: color-mix(
      in lab,
      var(--color-foreground),
      var(--color-background) 40%
    );
    font-size: 13px;
  }

  /* Add focus styles for better accessibility */
  .tooltip-container:focus-visible {
    border-radius: 120px;
  }
</style>

<script>
  // Add keyboard support for tooltip
  document.addEventListener('DOMContentLoaded', () => {
    const albumPosters = document.querySelectorAll('.album-poster');
    
    albumPosters.forEach(poster => {
      const tooltip = poster.querySelector('.tooltip');
      
      if (tooltip) {
        // Show tooltip on focus for keyboard users
        poster.addEventListener('focus', () => {
          tooltip.setAttribute('aria-hidden', 'false');
        });
        
        // Hide tooltip on blur
        poster.addEventListener('blur', () => {
          tooltip.setAttribute('aria-hidden', 'true');
        });
        
        // Handle escape key to hide tooltip
        poster.addEventListener('keydown', (e) => {
          const keyboardEvent = e as KeyboardEvent;
          if (keyboardEvent.key === 'Escape') {
            (poster as HTMLElement).blur();
          }
        });
      }
    });
  });
</script> 