---
// Cavaliers data is loaded client-side from /api/cavaliers so it updates
// without a full rebuild (API runs as a Vercel serverless function).
---
<span class="lowercase" id="latest-cavaliers">
  cavs game
</span>

<script>
  (function () {
    const el = document.getElementById("latest-cavaliers");
    if (!el) return;

    fetch("/api/cavaliers")
      .then((r) => r.json())
      .then((data) => {
        if (data.prefix && data.result) {
          el.innerHTML = `${data.prefix}<i>${data.result}</i>`;
        }
      })
      .catch(() => {});
  })();
</script>
