---
// Fetch the latest Letterboxd activity from RSS feed
import Tooltip from './Tooltip.astro';

const rssUrl = 'https://letterboxd.com/jsca/rss';

let latestFilm: {
  title: string;
  year: string;
  rating: string;
  reviewText: string;
  reviewUrl: string;
  imageUrl: string;
  watchedDate: string;
  watchedTime: string;
} | null = null;
let error: string | null = null;

try {
  const response = await fetch(rssUrl);
  if (response.ok) {
    const xmlText = await response.text();
    
    // Parse the RSS XML to extract the latest film
    // Use a simple regex-based parser since DOMParser isn't available server-side
    const itemMatch = xmlText.match(/<item>([\s\S]*?)<\/item>/);
    
    if (itemMatch) {
      const itemContent = itemMatch[1];
      
      // Extract title
      const titleMatch = itemContent.match(/<title>(.*?)<\/title>/);
      const title = titleMatch ? titleMatch[1] : '';
      
      // Extract pubDate with timezone offset
      const pubDateMatch = itemContent.match(/<pubDate>(.*?)<\/pubDate>/);
      const pubDate = pubDateMatch ? pubDateMatch[1] : '';
      
      // Parse pubDate and calculate watchedTime with offset
      let watchedTime = '';
      if (pubDate) {
        try {
          // Parse the pubDate string (format: "Wed, 30 Jul 2025 07:35:11 +1200")
          const date = new Date(pubDate);
          if (!Number.isNaN(date.getTime())) {
            // Format as compact time (e.g., "12:44P")
            const hours = date.getHours();
            const minutes = date.getMinutes().toString().padStart(2, '0');
            const period = hours >= 12 ? 'P' : 'A';
            const displayHours = hours === 0 ? 12 : hours > 12 ? hours - 12 : hours;
            watchedTime = `${displayHours}:${minutes}${period}`;
          }
        } catch (e) {
          // Fallback to original pubDate if parsing fails
          watchedTime = pubDate;
        }
      }
      
      // Extract watched date 
      const watchedDateMatch = itemContent.match(/<letterboxd:watchedDate>(.*?)<\/letterboxd:watchedDate>/);
      let watchedDate = watchedDateMatch ? watchedDateMatch[1] : '';
      
      // Format watchedDate to DD/MMM/YY format
      if (watchedDate) {
        try {
          const date = new Date(watchedDate);
          if (!Number.isNaN(date.getTime())) {
            const day = date.getDate().toString().padStart(2, '0');
            const month = date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase();
            const year = date.getFullYear().toString().slice(-2);
            watchedDate = `${day}/${month}/${year}`;
          }
        } catch (e) {
          // Keep original format if parsing fails
        }
      }
      
      // Extract link
      const linkMatch = itemContent.match(/<link>(.*?)<\/link>/);
      const link = linkMatch ? linkMatch[1] : '';
      
      // Extract description
      const descMatch = itemContent.match(/<description>(.*?)<\/description>/);
      const description = descMatch ? descMatch[1] : '';
      
      // Extract rating from the title (format: "Film Title ★★★★☆")
      const ratingMatch = title.match(/★+/);
      const rating = ratingMatch ? ratingMatch[0] : '';
      
      // Extract film title (all characters before ", 19XX" or ", 20XX")
      const filmTitle = title.replace(/,\s*(19|20)\d{2}.*$/, '').trim();
      
      // Extract year (19XX or 20XX)
      const yearMatch = title.match(/,\s*(19|20)\d{2}/);
      const year = yearMatch ? yearMatch[1] + yearMatch[0].slice(-2) : '';
      
      // Extract review text from description
      const reviewText = description.replace(/<[^>]*>/g, '').replace(/]]>/g, '').trim();
      
      // Try to extract image URL from description
      const imgMatch = description.match(/<img[^>]+src="([^"]+)"/);
      const imageUrl = imgMatch ? imgMatch[1] : '';
      
      latestFilm = {
        title: filmTitle,
        year,
        rating,
        reviewText,
        reviewUrl: link,
        imageUrl,
        watchedDate,
        watchedTime
      };
    }
  } else {
    error = `Failed to fetch RSS feed: ${response.status}`;
  }
} catch (err) {
  const errorMessage = err instanceof Error ? err.message : String(err);
  error = `Error fetching Letterboxd data: ${errorMessage}`;
}
---

{latestFilm && !error ? (
  <>
    {latestFilm.imageUrl && (
      <Tooltip 
        content={`${latestFilm.title} (${latestFilm.year}) - ${latestFilm.rating}`}
        ariaLabel={`Poster for ${latestFilm.title} (${latestFilm.year})`}
        class="film-poster-container  draggable"
      >
        <figure class="film-poster">
          <img src={latestFilm.imageUrl} alt="" id="film-poster-img" />
        </figure>
        <div slot="tooltip-content">
          <div class="film-title-tooltip">
            {latestFilm.title} 
            (<span>{latestFilm.year}</span>)
          </div>
        </div>
      </Tooltip>
    )}
    
    <div class="film-ticket-container draggable relative">
      <div class="film-ticket-shadow" />
      <div class="film-ticket flex flex-col justify-between gap-3 ">
        <div class="flex flex-col gap-1">
          <span class="film-cinema">SKULL CINEMA 1</span>
          <h2 class="film-title">{latestFilm.title}</h2>
        </div>
        <div class="flex justify-between gap-2">
          <div class="flex flex-col gap-1">
            <span class="film-year">{latestFilm.year}</span>
            <span class="film-time">{latestFilm.watchedTime}</span>
          </div>
          <div class="flex flex-col justify-end items-end gap-1">
            <span class="film-rating">{latestFilm.rating}</span>
            <span class="film-date">{latestFilm.watchedDate}</span>
          </div>
        </div>
      </div>
    </div>
  </>
) : error ? (
  <section class="latest-letterboxd error">
    <p>Unable to load latest Letterboxd activity. Please check your username configuration.</p>
  </section>
) : null}

<style>
  .film-poster-container {
    flex-shrink: 0;
    display: block;
  }

  .film-poster {
    flex-shrink: 0;
  }
  
  .film-ticket-container {
  }

  .film-poster img {
    width: 150px;
    height: 225px;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 3px 3px 0 rgb(0, 0, 0, 0.2);
  }
  
  .film-ticket,
  .film-ticket-shadow {
    width: 180px;
    height: 112px;
    border-radius: 3px;
    transform: rotate(-4deg);
  }
  
  .film-ticket-shadow {
    position: absolute;
    top: 3px;
    left: 3px;
    background-color: rgb(0, 0, 0, 0.2);
  }
  
  .film-ticket {
    font-family: var(--font-family-mono);
    line-height: 1;
    background: #F7F6F5 url("data:image/svg+xml;base64,");
    color: #51493A;
    border-radius: 3px;
    padding: 16px;
    clip-path: polygon(1.5% 0%, 100% 0%, 100% 100%, 1% 100%, 2% 95%, 0.5% 90%, 1.8% 85%, 1.2% 80%, 2% 75%, 0.8% 70%, 1.9% 65%, 1.3% 60%, 2% 55%, 1.1% 50%, 1.7% 45%, 0.9% 40%, 1.8% 35%, 1.4% 30%, 2% 25%, 1.2% 20%, 1.6% 15%, 1% 10%, 1.5% 5%);
  }
  
  .film-cinema {
    display: block;
  }
  
  .film-title {
    margin: 0;
    width: 19ch;
    overflow: hidden;
    text-overflow: clip;
    white-space: nowrap;
    color: #51493A;
  }
  
  .film-title,
  .film-year {
    font-size: 0.825rem;
  }
  
  .film-rating {
    font-size: 1.3rem;
    line-height: 0.5;
    position: relative;
    top: -3px;
  }

  .film-cinema,
  .film-time,
  .film-date {
    font-size: 0.5rem;
  }

</style>

<script is:inline>
  // Apply dither effect to film poster
  document.addEventListener('DOMContentLoaded', () => {
    const filmPosterImg = document.getElementById('film-poster-img');
    
    if (filmPosterImg) {
      // Get the original image URL
      const originalSrc = filmPosterImg.src;
      
      // Create a new image to avoid CORS issues
      const img = new Image();
      img.crossOrigin = 'anonymous';
      
      img.onload = () => {
        try {
          // Use the shared DitherShader from the global scope
          if (window.DitherShader) {
            const shader = new window.DitherShader();
            // Use stronger dithering and larger pixel size for more pronounced effect
            const processedCanvas = shader.processImage(img, 1, 4);
            
            // Replace the original image with the processed one
            filmPosterImg.src = processedCanvas.toDataURL('image/jpeg', 0.9);
          } else {
            console.warn('DitherShader not available');
          }
        } catch (error) {
          console.warn('Failed to apply dither effect:', error);
          // Keep original image if dither fails
        }
      };
      
      img.onerror = () => {
        console.warn('Failed to load image for dither processing');
      };
      
      // Use the serverless function to avoid CORS issues
      const proxyUrl = `/api/proxy-image?url=${encodeURIComponent(originalSrc)}`;
      img.src = proxyUrl;
    }
  });
</script>