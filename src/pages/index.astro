---
import Layout from "../layouts/Layout.astro";
import LatestCavaliers from "../components/LatestCavaliers.astro";
import LatestLetterboxd from "../components/LatestLetterboxd.astro";
import LatestSpotify from "../components/LatestSpotify.astro";

const valuesAndPractices = [
  {
    value: "clarity",
    practice: "showing and telling",
  },
  {
    value: "inclusivity",
    practice: "proactive advocacy",
  },
  {
    value: "irreverence",
    practice: "play and experimentation",
  },
  {
    value: "intention",
    practice: "leading with purpose",
  },
  {
    value: "openness",
    practice: "removing barriers to entry",
  },
];

const title = "skullface.me 🫶";
---

<script src="/scripts/ditherShader.js" defer></script>
<Layout title={title}>
  <main>
    <h1>skullface</h1>

    <p>
      call me <i>skully</i>! i’m a <i>creative generalist</i> and day-brightener in
      cleveland, ohio, always trying to leave things better than i found them. ✌️(⸝⸝
      • ◡ • ⸝⸝)
    </p>

    <h2>Work</h2>
    <p>
      i use design, code, and ops management to make customer acquisition
      metrics go <i>up and to the right</i> for devtools and infra companies.
    </p>

    <ul>
      <li class="flex justify-between">
        <span><b>vercel</b>, senior design engineer</span>
        <span class="">2025 – present</span>
      </li>
      <li class="flex justify-between">
        <span><b>planetscale</b> + <b>clerk</b>, design manager</span>
        <span class="">2021 – 2024 </span>
      </li>
      <li class="flex justify-between">
        <span><b>github</b>, design engineer</span>
        <span class="">2017 – 2021 </span>
      </li>
    </ul>

    <div>
      <h2>Most recent</h2>
      <ul>
        <li>
          🎬
          <LatestLetterboxd />
        </li>
        <li>
          🎵
          <LatestSpotify />
        </li>
        <li>🎮 persona 5 royal on playstation 5</li>
        <li class="grayscale">
          🏀
          <LatestCavaliers />
        </li>
      </ul>

      <div>
        <h2>Values and practices</h2>
        <ul class="values-and-practices">
          {
            valuesAndPractices.map(({ value, practice }) => (
              <li>
                <span class="value">
                  <b>{value}</b>
                  <span aria-label="via" class="through" />
                </span>
                {practice}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <style>
      .values-and-practices {
        min-width: 368px;

        li {
          display: flex;
          flex-direction: column;
          @media all and (max-width: 680px) {
            margin-bottom: calc(var(--spacer) * 2);
          }
          @media all and (min-width: 680px) {
            flex-direction: row;
            align-items: center;
          }
          &:nth-of-type(even) .through {
            transform: scaleY(-1);
          }
        }

        .value {
          display: flex;
          @media all and (max-width: 680px) {
            margin-bottom: calc(var(--spacer) * 0.5);
          }
          @media all and (min-width: 680px) {
            justify-content: space-between;
            width: 45%;
            padding-right: var(--spacer);
          }
        }

        .through {
          @media all and (min-width: 680px) {
            margin-left: var(--spacer);
            flex: 1;
            background: url("data:image/svg+xml;base64,")
              center right no-repeat;
            background-size: auto 1em;
          }
        }
      }
    </style>
  </main>
</Layout>
