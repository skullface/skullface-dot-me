---
import Layout from "../layouts/Layout.astro";
import LatestLetterboxd from "../components/LatestLetterboxd.astro";
import LatestSpotify from "../components/LatestSpotify.astro";
import Kaomoji from "../components/Kaomoji.astro";
import Currently from "../components/Currently.astro";

const title = "skullface.me 🫶";
---

<script src="/scripts/ditherShader.js" defer></script>
<Layout title={title}>
  <main>
    <h1>
      i make websites, brands, and art!
    </h1>

    <p>
      hiii i’m <b>@skullface</b>, “skully” for short! i’m a creative generalist <br class="hidden md:block" />
      always trying to leave things better than i found them.
    </p>
    
    <div class="relative flex flex-col mt-6 gap-4 w-full h-full min-h-[500px] md:min-h-[340px]">
      <LatestLetterboxd />
      <LatestSpotify />
      <Currently />
      <Kaomoji />
    </div>
    
  </main>
</Layout>

<style>
  main {
    max-width: var(--page-width);
  }

  h1 {
    @media all and (max-width: 680px) {
      font-size: 2.5em;
    }
    line-height: 95%;
    span {
      margin-top: 4px;
      font-size: 0.94em;
      display: block;
      font-family: var(--font-family-serif);
      font-weight: 400;
      letter-spacing: -0.5px;
      line-height: 85%;
    }
  }
</style>
