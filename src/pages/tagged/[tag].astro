---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Card from "../../components/Card.astro";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  const notes = await getCollection("notes");

  const tags: string[] = [];
  blogPosts.forEach((post: CollectionEntry<"blog">) => {
    post.data.tags?.forEach((t: string) => tags.push(t.toLowerCase()));
  });
  notes.forEach((note: CollectionEntry<"notes">) => {
    note.data.tags?.forEach((t: string) => tags.push(t.toLowerCase()));
  });

  return Array.from(new Set(tags)).map((tag) => ({
    params: { tag },
  }));
}

const tag = Astro.params.tag ?? "";
const blogPosts = await getCollection("blog");
const notes = await getCollection("notes");

const hasTag = (tagList: string[] | undefined, t: string) =>
  (tagList ?? []).map((x: string) => x.toLowerCase()).includes(t.toLowerCase());

const matchingBlog = blogPosts.filter((post) => hasTag(post.data.tags, tag));
const matchingNotes = notes.filter((note) => hasTag(note.data.tags, tag));

const byDate = (a: { data: { datePublished: Date } }, b: { data: { datePublished: Date } }) =>
  new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime();
const items = [...matchingBlog, ...matchingNotes].sort(byDate);
---

<Layout title={`Posts and notes tagged ${tag}`}>
  <main>
    <h1>Tagged with <b>{tag}</b></h1>
    <ul class="grid gap-2">
      {
        items.map((item) => {
          const isBlog = "description" in item.data;
          const href = isBlog ? `/blog/${item.id}` : `/notes/${item.id}`;
          const title = item.data.title;
          const body = isBlog
            ? (item as CollectionEntry<"blog">).data.description
            : "Note";
          const footer = item.data.datePublished.toDateString();
          return (
            <li>
              <Card href={href} title={title} body={body} footer={footer} />
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>
